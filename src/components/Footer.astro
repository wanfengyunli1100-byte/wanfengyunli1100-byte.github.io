---
/**
 * 页脚：型号条 + 联系方式 + 回到顶部
 * 数据手册风：细线分区、等宽小字、无底色块
 */
import { site } from '../config/site';

const year = new Date().getFullYear();
const ds = site.datasheet;
---

<footer class="footer">
  <div class="wrap foot-in">
    <div class="side">
      <span class="line">{ds.model} · {site.name} · {site.tagline}</span>
      <span class="line dim">© {year} · 个人作品档案</span>
    </div>
    <div class="side right">
      <span class="line">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <span class="dim"> / </span>
        <a href={site.github} target="_blank" rel="noopener">GITHUB</a>
      </span>
      <span class="line dim">
        <a href="#top">回到顶部 ↑</a>
      </span>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: var(--sp-4) 0 var(--sp-6);
    border-top: 1px solid var(--border);
  }

  .foot-in {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-3);
    flex-wrap: wrap;
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .right {
    text-align: right;
  }

  .line {
    font-family: var(--font-mono);
    font-size: var(--fs-0);
    letter-spacing: var(--ls-wide);
    color: var(--text-secondary);
  }

  .dim {
    color: var(--text-muted);
  }

  a {
    color: var(--accent);
    text-decoration: none;
  }

  a:hover {
    /* 与 --accent 同色：两个相邻橙棕肉眼难辨，反馈交给下划线，不引入第二个强调色 */
    color: var(--accent);
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .right {
      text-align: left;
    }
  }
</style>
