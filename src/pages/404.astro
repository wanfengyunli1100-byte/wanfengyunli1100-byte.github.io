---
/**
 * 404（M3a）
 * 体例：数据手册的"检索失败"页 —— ERR 码 + 状态 + 建议入口
 * 纯静态、无 JS：关掉脚本也完整可读
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 · 页面未找到" description="请求的页面不存在。">
  <header class="page-head">
    <div class="wrap">
      <p class="kicker">ERR 404 / PART NOT FOUND</p>
      <h1>找不到这个页面</h1>
      <p class="lead">请求的地址不存在 —— 可能已经改名，或者从未存在过。</p>

      <table class="spec">
        <tbody>
          <tr>
            <th scope="row">CODE</th>
            <td><b>404</b></td>
            <th scope="row">STATUS</th>
            <td>未找到</td>
          </tr>
          <tr>
            <th scope="row">HINT</th>
            <td colspan="3">检查地址拼写，或从下面的入口重新进入</td>
          </tr>
        </tbody>
      </table>
    </div>
  </header>

  <section>
    <div class="wrap">
      <div class="sec-title">
        <span class="no">01</span><h2>去这里</h2><span class="hint">NAVIGATE</span>
      </div>
      <div class="contact">
        <a class="item" href="/">
          <span class="k mono">HOME</span>
          <span class="v">首页 →</span>
        </a>
        <a class="item" href="/projects/">
          <span class="k mono">PROJECTS</span>
          <span class="v">项目索引 →</span>
        </a>
        <a class="item" href="/about/">
          <span class="k mono">ABOUT</span>
          <span class="v">关于 →</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
